{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/VAIF-TECH/vaif-cli/main/schemas/vaif-config.schema.json",
  "title": "VAIF Studio CLI configuration",
  "description": "Schema for vaif.config.json — defines projectId, database, types, and api settings used by the @vaif/cli toolchain.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "URI of the JSON Schema for editor autocomplete."
    },
    "projectId": {
      "type": "string",
      "description": "VAIF Studio project ID (e.g. proj_xxx). May be empty when project is set via env var or login session."
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "description": "Postgres connection URL. Supports ${ENV_VAR} interpolation."
        },
        "schema": {
          "type": "string",
          "default": "public",
          "description": "Database schema name to introspect / generate types from."
        }
      }
    },
    "types": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output": {
          "type": "string",
          "description": "Output path for generated TypeScript types.",
          "default": "./src/types/database.ts"
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "description": "VAIF API base URL.",
          "default": "https://api.vaif.studio"
        }
      }
    }
  }
}
